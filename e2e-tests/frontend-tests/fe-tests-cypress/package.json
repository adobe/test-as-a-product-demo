{
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^24.0.0",
    "@faker-js/faker": "^8.1.0",
    "cypress": "^13.2.0",
    "cypress-multi-reporters": "^2.0.5",
    "eslint-plugin-license-header": "^0.6.0",
    "mocha-junit-reporter": "^2.2.1",
    "mochawesome": "^7.1.4"
  },
  "scripts": {
    "cy:run": "cypress run"
  },
  "dependencies": {
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.0",
    "axios": "^1.5.1"
  },
  "cypress-cucumber-preprocessor": {
    "stepDefinitions": "cypress/e2e/**/*.spec.{js,ts}",
    "json": {
      "enabled": true,
      "output": "reports/cucumber/cucumber-report.json"
    },
    "messages": {
      "enabled": true,
      "output": "reports/cucumber/messages.ndjson"
    }
  }
}
